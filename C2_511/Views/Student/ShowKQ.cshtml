@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Kết quả đăng ký";
}
<h2>Kết quả đăng ký</h2>
<p>Cảm ơn bạn <b>@ViewBag.MSSV</b> - <b>@ViewBag.HoTen</b> đã đăng ký chuyên ngành <b>@ViewBag.ChuyenNganh</b>.</p>
<p>Số lượng sinh viên đã đăng ký cùng chuyên ngành với bạn: <b>@ViewBag.SameMajorCount</b></p>
<a asp-action="Index">Quay lại trang đăng ký</a>
<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f7f6;
        display: flex;
        justify-content: center;
        padding-top: 80px;
    }

    .result-container {
        background-color: #ffffff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 550px;
        text-align: center;
        border-top: 5px solid #27ae60; /* Màu xanh lá đại diện cho thành công */
    }

    .success-icon {
        font-size: 50px;
        color: #27ae60;
        margin-bottom: 20px;
    }

    h2 {
        color: #2c3e50;
        margin-bottom: 20px;
        font-size: 24px;
    }

    .info-box {
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 25px;
        line-height: 1.8;
        text-align: left;
        border-left: 4px solid #3498db;
    }

        .info-box b {
            color: #e67e22; /* Màu cam cho các thông tin quan trọng */
        }

    .count-highlight {
        display: inline-block;
        background-color: #3498db;
        color: white;
        padding: 2px 10px;
        border-radius: 20px;
        font-weight: bold;
    }

    .btn-back {
        display: inline-block;
        text-decoration: none;
        background-color: #3498db;
        color: white;
        padding: 10px 25px;
        border-radius: 5px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            background-color: #2980b9;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transform: translateY(-2px);
        }
</style>